<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bob.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/bob</string>
        <string>--config</string>
        <string>/Users/codemon_/.bob/config.yaml</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/codemon_/.bob/bob.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/codemon_/.bob/bob.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/codemon_/Documents/Bob-AI</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>ProcessType</key>
    <string>Standard</string>
</dict>
</plist>
