# Bob Environment Variables Example

# Server Configuration
BOB_SERVER_HOST=0.0.0.0
BOB_SERVER_PORT=8787
BOB_API_TOKEN=your-secure-api-token-here

# Local LLM Configuration (Ollama)
BOB_LLM_PROVIDER=ollama
BOB_LLM_BASE_URL=http://127.0.0.1:11434
BOB_LLM_MODEL=qwen2.5-coder:7b

# Data & Storage
BOB_DATA_DIR=/Users/codemon_/.bob
